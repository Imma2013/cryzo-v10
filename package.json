{
  "name": "cryzo-v10",
  "version": "0.1.0",
  "description": "Cryzo v10 web app",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Imma2013"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Imma2013/cryzo-v10.git"
  },
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ts": "tsc -p tsconfig.web.json --noEmit",
    "lint": "npx oxlint src/web api --fix",
    "lint:fix": "npx oxlint src/web api --fix --fix-suggestions --fix-dangerously",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "fmt:check": "npx oxfmt --check src/web api",
    "fmt": "npx oxfmt src/web api",
    "presubmit": "npm run ts && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^5.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "productName": "Cryzo v10"
}
